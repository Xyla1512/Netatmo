msgid "Could not save the display name."
msgstr "Der Anzeigename konnte nicht gespeichert werden."

msgid "Display name for %s"
msgstr "Anzeigename für %s"

msgid "Netatmo: %s"
msgstr "Netatmo: %s"

msgid "Saved"
msgstr "Gespeichert"

